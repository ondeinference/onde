# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# IDE
.idea/
*.iml
local.properties

# Native shared libraries — these are build artifacts produced by
# `build-kotlin.sh` and should not be committed to version control.
# Each developer / CI run cross-compiles them from the Rust source.
onde/src/main/jniLibs/**/*.so

# UniFFI-generated Kotlin source — regenerated by `build-kotlin.sh`.
# Keeping it out of VCS avoids stale-binding bugs after Rust API changes.
onde/src/main/kotlin/com/ondeinference/onde/onde.kt

# Gradle wrapper jar (use `gradle wrapper` to regenerate)
# Uncomment the next line if you prefer to commit the wrapper jar:
# !gradle/wrapper/gradle-wrapper.jar

# macOS
.DS_Store

# Android Studio / IntelliJ
captures/
*.hprof
